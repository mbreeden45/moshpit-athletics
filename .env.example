# Printify personal access token (Printify > My profile > Connections).
# Server-only: never prefix with NEXT_PUBLIC_.
PRINTIFY_API_TOKEN=

# Shop ID of the Printify Pop-Up store (sales_channel "storefront").
# Run `npm run discover-shop` to look it up. If left blank, the app
# discovers it at runtime via GET /v1/shops.json.
PRINTIFY_SHOP_ID=24807399

# Public base URL of the Printify Pop-Up store that handles checkout.
NEXT_PUBLIC_POPUP_URL=https://mosh-pit-athletics.printify.me/

# Canonical URL of this storefront (sitemap, canonical tags, OG cards).
NEXT_PUBLIC_SITE_URL=https://moshpitathletics.com
