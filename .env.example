# Printify personal access token (Printify > My profile > Connections).
# Server-only: never prefix with NEXT_PUBLIC_.
PRINTIFY_API_TOKEN=

# Shop ID of the Printify Pop-Up store (sales_channel "storefront").
# Run `npm run discover-shop` to look it up. If left blank, the app
# discovers it at runtime via GET /v1/shops.json.
PRINTIFY_SHOP_ID=24807399

# Public base URL of the Printify Pop-Up store (Archive link, Terms/Privacy).
NEXT_PUBLIC_POPUP_URL=https://mosh-pit-athletics.printify.me/

# Canonical URL of this storefront (sitemap, canonical tags, OG cards).
NEXT_PUBLIC_SITE_URL=https://moshpitathletics.com

# Stripe (Dashboard > Developers > API keys). Server-only.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint pointed at /api/stripe/webhook,
# subscribed to checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# Test-mode payments only: "off" (default) logs the Printify order, "draft"
# creates it in Printify without sending it to print. Live payments always print.
PRINTIFY_TEST_ORDERS=off
